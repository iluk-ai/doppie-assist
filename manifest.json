{
  "manifest_version": 3,
  "name": "Doppie Assist",
  "version": "0.24.0",
  "minimum_chrome_version": "116",
  "key": "",
  "description": "Capture, annotate, and turn any part of the web into a Linear issue.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "unlimitedStorage",
    "clipboardWrite",
    "identity",
    "downloads",
    "alarms",
    "offscreen",
    "tabCapture"
  ],
  "host_permissions": [
    "https://api.linear.app/*",
    "https://uploads.linear.app/*",
    "https://api.github.com/repos/iluk-ai/doppie-assist/*",
    "https://github.com/iluk-ai/doppie-assist/releases/download/*",
    "http://127.0.0.1:47361/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Doppie Assist",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "capture-region": {
      "suggested_key": { "default": "Ctrl+Shift+1", "mac": "Command+Shift+1" },
      "description": "Capture a region"
    },
    "capture-element": {
      "suggested_key": { "default": "Ctrl+Shift+2", "mac": "Command+Shift+2" },
      "description": "Review and annotate page elements"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dev-context.js", "issue-format.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon-32.png",
        "assets/outfit-latin.woff2",
        "assets/outfit-latin-ext.woff2",
        "assets/dm-serif-display-latin.woff2",
        "assets/dm-serif-display-latin-ext.woff2"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
